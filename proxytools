#!/bin/sh
# Unified project launcher. It bootstraps an isolated Python environment on the
# first real command, then delegates to the corresponding internal CLI module.

set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VENV_DIR="$PROJECT_DIR/.venv"

show_help() {
    printf '%s\n' \
        'Usage: ./proxytools <command> [options]' \
        '' \
        'Commands:' \
        '  list       Find and print working proxies (default)' \
        '  monitor    Monitor proxies until they meet stability criteria' \
        '  help       Show this help' \
        '' \
        'Options:' \
        '  --version  Show the installed Proxy Tools version' \
        '  --about    Show project information and credits' \
        '  --clear    Remove local databases, environment, locks, and generated caches' \
        '' \
        'Run ./proxytools <command> --help for command-specific options.' \
        'On first use, a local .venv and the required dependencies are created automatically.'
}

if [ "$#" -eq 0 ]; then
    COMMAND=list
else
    COMMAND=$1
    case "$COMMAND" in
        list|monitor)
            shift
            ;;
        help|-h|--help|--version|--about|--abut|--clear)
            shift
            ;;
        -*)
            COMMAND=list
            ;;
        *)
            shift
            ;;
    esac
fi

if [ "$COMMAND" = "--clear" ]; then
    if ! command -v python3 >/dev/null 2>&1; then
        printf 'proxytools: python3 is required but was not found in PATH\n' >&2
        exit 1
    fi
    PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
    PROXYTOOLS_HOME="$PROJECT_DIR"
    export PYTHONPATH PROXYTOOLS_HOME
    exec python3 -m proxytools.cleanup
fi

case "$COMMAND" in
    help|-h|--help)
        show_help
        exit 0
        ;;
    --version|--about|--abut)
        ;;
    list)
        ;;
    monitor)
        ;;
    *)
        printf 'proxytools: unknown command: %s\n\n' "$COMMAND" >&2
        show_help >&2
        exit 2
        ;;
esac

if [ ! -x "$VENV_DIR/bin/python" ]; then
    if ! command -v python3 >/dev/null 2>&1; then
        printf 'proxytools: python3 is required but was not found in PATH\n' >&2
        exit 1
    fi
    printf 'Creating local Python environment in %s ...\n' "$VENV_DIR" >&2
    python3 -m venv "$VENV_DIR"
fi

BASE_STAMP="$VENV_DIR/.proxytools-package-metadata"
if ! cmp -s "$PROJECT_DIR/pyproject.toml" "$BASE_STAMP" 2>/dev/null || \
   ! "$VENV_DIR/bin/python" -c 'import maxminddb, requests, rich, selenium, socks, textual' >/dev/null 2>&1; then
    printf 'Installing dependencies ...\n' >&2
    "$VENV_DIR/bin/python" -m pip install -e "$PROJECT_DIR"
    cp "$PROJECT_DIR/pyproject.toml" "$BASE_STAMP"
fi

cd "$PROJECT_DIR"
PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
PROXYTOOLS_HOME="$PROJECT_DIR"
export PYTHONPATH PROXYTOOLS_HOME
exec "$VENV_DIR/bin/python" -m proxytools "$COMMAND" "$@"
